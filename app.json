{
  "expo": {
    "name": "hacknation-hackathon",
    "slug": "hacknation-hackathon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-camera", { "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to identify plants." }],
      ["expo-image-picker", { "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to pick plant images.", "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to identify plants.", "microphonePermission": false }]
    ],
    "scheme": "hacknation"
  }
}
